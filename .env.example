# --- Panel ---
PORT=7788
HOST=0.0.0.0
# actions = build with GitHub Actions (recommended) | local = build on this machine
BUILD_MODE=actions

# --- GitHub ---
# A Personal Access Token with "repo" scope (needed to create releases and dispatch workflows)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GITHUB_OWNER=farsipsx
GITHUB_REPO=ps1app
GITHUB_WORKFLOW=build-game.yml
# Branch that contains .github/workflows/build-game.yml
GITHUB_REF=main

# --- Android app identity ---
# Final package will be: com.farsipsx.ps1app.<slug>
BASE_PACKAGE=com.farsipsx.ps1app
VERSION_CODE=1
VERSION_NAME=1.0
