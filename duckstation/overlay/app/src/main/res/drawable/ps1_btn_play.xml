<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:state_enabled="true">
        <shape android:shape="rectangle">
            <gradient android:angle="45" android:startColor="#1f9c76" android:endColor="#157f99" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#334155" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="45" android:startColor="#34d399" android:centerColor="#22d3ee" android:endColor="#60a5fa" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
