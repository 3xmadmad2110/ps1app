<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ps1_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:background="@drawable/ps1_card"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ps1_download_dialog_title"
            android:textColor="#22d3ee"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ps1_dlg_phase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ps1_dlg_phase_unknown"
            android:textColor="#a78bfa"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ps1_dlg_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ps1_dlg_file_unknown"
            android:textColor="#94a3bd"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ps1_dlg_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ps1_status_need_data"
            android:textColor="#e8edf7"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/ps1_dlg_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100"
            android:progressDrawable="@drawable/ps1_progress" />

        <TextView
            android:id="@+id/ps1_dlg_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ps1_detail_unknown"
            android:textColor="#94a3bd"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/ps1_dlg_pause"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/ps1_btn_download"
                android:minHeight="48dp"
                android:text="@string/ps1_pause"
                android:textAllCaps="false"
                android:textColor="#ffffff"
                android:textStyle="bold" />

            <Button
                android:id="@+id/ps1_dlg_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:background="@drawable/ps1_btn_settings"
                android:minHeight="48dp"
                android:text="@string/ps1_cancel"
                android:textAllCaps="false"
                android:textColor="#e8edf7" />
        </LinearLayout>

        <Button
            android:id="@+id/ps1_dlg_play"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/ps1_btn_play"
            android:minHeight="50dp"
            android:text="@string/ps1_play"
            android:textAllCaps="false"
            android:textColor="#ffffff"
            android:textStyle="bold"
            android:visibility="gone" />

        <Button
            android:id="@+id/ps1_dlg_close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/ps1_btn_settings"
            android:minHeight="46dp"
            android:text="@string/ps1_dlg_close"
            android:textAllCaps="false"
            android:textColor="#e8edf7" />

    </LinearLayout>
</ScrollView>
