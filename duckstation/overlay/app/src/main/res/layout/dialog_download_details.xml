<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ps1_download_dialog_title"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/ps1_dlg_phase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/ps1_dlg_phase_unknown"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/ps1_dlg_file"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/ps1_dlg_file_unknown"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/ps1_dlg_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/ps1_status_need_data"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/ps1_dlg_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:max="100" />

        <TextView
            android:id="@+id/ps1_dlg_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ps1_detail_unknown"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/ps1_dlg_pause"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ps1_pause" />

            <Button
                android:id="@+id/ps1_dlg_cancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/ps1_cancel" />
        </LinearLayout>

        <Button
            android:id="@+id/ps1_dlg_play"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ps1_play"
            android:visibility="gone" />

        <Button
            android:id="@+id/ps1_dlg_close"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/ps1_dlg_close" />

    </LinearLayout>
</ScrollView>
