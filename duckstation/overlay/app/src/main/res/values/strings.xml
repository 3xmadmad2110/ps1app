    <string name="settings_load_patch_codes">بارگذاری کدهای پچ</string>
    <string name="settings_summary_save_state_on_exit">هنگام خاموش کردن یا خروج، وضعیت شبیهساز بهطور خودکار ذخیره میشود. دفعه بعد میتوانید مستقیم از همان نقطه ادامه دهید.</string>
    <string name="settings_summary_load_patch_codes"><![CDATA[کدهای پچ را از cheats/<نام بازی>.cht در قالب PCSXR بارگذاری میکند. کدها را میتوان در حین بازی روشن و خاموش کرد.]]></string>
    <string name="settings_apply_compatibility_settings">اعمال تنظیمات سازگاری</string>
    <string name="settings_summary_apply_compatibility_settings">بهطور خودکار بهبودهایی را که توسط بازیها پشتیبانی نمیشوند غیرفعال میکند.</string>
    <string name="settings_summary_video_sync">این گزینه نرخ تازهسازی DuckStation را با صفحه دستگاه هماهنگ میکند. در صورت امکانپذیر نبودن (مثلاً سرعت غیر از ۱۰۰٪)، VSync بهطور خودکار خاموش میشود.</string>
    <string name="settings_video_sync">همگامسازی ویدیو</string>
    <string name="settings_cpu_overclocking">اورکلاک CPU</string>
    <string name="settings_cdrom_region_check">بررسی منطقه</string>
    <string name="settings_summary_cdrom_region_check">جلوگیری میکند از خواندن دیسکهایی که منطقهشان اشتباه است. معمولاً خاموش کردن آن ایمن است.</string>
    <string name="settings_cdrom_preload_image_to_ram">پیشبارگذاری ایمج در RAM</string>
    <string name="settings_summary_preload_image_to_ram">ایمج بازی را در حافظه RAM بارگذاری میکند. برای مسیرهای شبکهای که ممکن است در حین بازی ناپایدار شوند مفید است. در برخی موارد لرزش هنگام شروع پخش آهنگ دیسک را هم از بین میبرد.</string>
    <string name="settings_pgxp_vertex_cache">کش رئوس PGXP</string>
    <string name="settings_summary_pgxp_vertex_cache">هنگامی که ردیابی رئوس در حافظه شکست خورد، از مختصات صفحه بهعنوان جایگزین استفاده میکند. ممکن است سازگاری PGXP را بهبود دهد.</string>
    <string name="settings_pgxp_cpu_mode">حالت CPU در PGXP</string>
    <string name="settings_summary_pgxp_cpu_mode">سعی میکند دستکاری رئوس را توسط CPU ردیابی کند. برخی بازیها برای اثربخشی PGXP به این گزینه نیاز دارند. هزینه عملکردی زیادی دارد.</string>
    <string name="settings_cpu_recompiler_icache">کش دستورالعمل کامپایلر CPU</string>
    <string name="settings_summary_cpu_recompiler_icache">تعیین میکند که کش دستورالعمل CPU در کامپایلر شبیهسازی شود یا خیر. دقت را با هزینهای اندک بالا میبرد. اگر بازیها خیلی سریع اجرا میشوند، این گزینه را فعال کنید.</string>
    <string name="settings_cpu_recompiler_fastmem">دسترسی سریع به حافظه در کامپایلر CPU</string>
    <string name="settings_summary_cpu_recompiler_fastmem">دسترسی حافظه مهمان را با استفاده از page fault و backpatching کارآمدتر میکند. اگر روی دستگاه شما ناپایدار است، آنرا خاموش کنید.</string>
    <string name="settings_presented_frame_limit">محدودیت فریم ارائهشده</string>
    <string name="settings_logging_level">سطح لاگ</string>
    <string name="settings_log_to_file">نوشتن لاگ در فایل</string>
    <string name="settings_summary_log_to_file">پیامهای لاگ را در فایل duckstation.log داخل پوشه کاربر مینویسد. فقط برای اشکالزدایی استفاده کنید زیرا شبیهسازی را کند میکند.</string>
    <string name="settings_log_to_logcat">نوشتن لاگ در Logcat</string>
    <string name="settings_summary_log_to_logcat">پیامهای لاگ را در ثبتکننده پیامهای اندروید مینویسد. فقط زمانی مفید است که دستگاه به رایانه وصل باشد و از adb استفاده کنید.</string>
    <string name="settings_volume">حجم صدا</string>
    <string name="settings_summary_volume">حجم صدای خروجی شبیهساز را کنترل میکند.</string>
    <string name="settings_fast_forward_volume">حجم صدا در پیشروی سریع</string>
    <string name="settings_summary_fast_forward_volume">حجم صدای خروجی شبیهساز را هنگام پیشروی سریع کنترل میکند.</string>
    <string name="settings_mute_all_sound">بیصدا کردن همه صداها</string>
    <string name="settings_summary_mute_all_sound">جلوگیری میکند از پخش هرگونه صدایی توسط شبیهساز.</string>
    <string name="settings_mute_on_fast_forward">بیصدا کردن صدا در پیشروی سریع</string>
    <string name="settings_summary_mute_on_fast_forward">در پیشروی سریع یا حالت توربو صدا را بیصدا میکند. مفید است چون صدای PS1 با بازی تند میشود و زیر و بم آن تغییر میکند؛ بهجای صدای بد، موسیقی سکوت میشود.</string>
    <string name="settings_mute_cd_audio">بیصدا کردن صدای CD</string>
    <string name="settings_summary_mute_cd_audio">صدای CD-DA و XA را از CD-ROM بیصدا میکند. میتوان از آن برای خاموش کردن موسیقی پسزمینه برخی بازیها استفاده کرد.</string>
    <string name="settings_audio_backend">پشتوانه صدا</string>
    <string name="settings_audio_buffer_size">اندازه بافر صدا</string>
    <string name="settings_summary_audio_buffer_size">تأخیر بین تولید صدا و پخش آن از بلندگو را تعیین میکند. مقادیر کوچکتر تأخیر را کم میکنند، ولی نوسان سرعت شبیهسازی باعث گیر کردن صدا میشود.</string>
    <string name="settings_audio_sync">همگامسازی صدا</string>
    <string name="settings_summary_audio_sync">سرعت شبیهسازی را بر اساس فریمهای صدای خواستهشده توسط پشتوانه صدا تنظیم میکند. این کار نویز و شکستگی صدا را هنگام تند بودن شبیهسازی از بین میبرد. اگر سرعت ۱۰۰٪ نباشد، همگامسازی بهطور خودکار خاموش میشود.</string>
    <string name="settings_controller_type">نوع کنترلر</string>
    <string name="settings_enable_analog_mode_on_reset">فعالسازی حالت آنالوگ هنگام بازنشانی</string>
    <string name="settings_touchscreen_controller_view">نمای کنترلر لمسی</string>
    <string name="settings_auto_hide_touchscreen_controller">پنهانسازی خودکار کنترلر لمسی</string>
    <string name="settings_summary_auto_hide_touchscreen_controller">وقتی کنترلر خارجی شناسایی شود، کنترلر لمسی پنهان میشود.</string>
    <string name="settings_vibrate_on_press">لرزش هنگام فشردن</string>
    <string name="settings_summary_vibrate_on_press">هنگام فشردن دکمه لمسی لرزش کوتاهی ایجاد میکند. باید گزینه «لرزش هنگام لمس» در تنظیمات دستگاه فعال باشد.</string>
    <string name="settings_enable_vibration">لرزش دستگاه</string>
    <string name="settings_summary_enable_vibration">لرزش بازی را به موتور لرزاننده گوشی منتقل میکند.</string>
    <string name="settings_memory_card_1_type">نوع کارت حافظه ۱</string>
    <string name="settings_memory_card_2_type">نوع کارت حافظه ۲</string>
    <string name="settings_crop_mode">حالت برش</string>
    <string name="settings_aspect_ratio">نسبت تصویر</string>
    <string name="settings_linear_upscaling">بزرگنمایی خطی</string>
    <string name="settings_integer_upscaling">بزرگنمایی صحیح</string>
    <string name="settings_summary_linear_upscaling">تصویر را هنگام بزرگنمایی کنسول به صفحه نرم میکند.</string>
    <string name="settings_summary_integer_upscaling">برای حفظ نسبت صحیح پیکسلهای دستگاه به پیکسلهای کنسول، حاشیه اضافه میکند. ممکن است برخی بازیهای 2D تیزتر شوند.</string>
    <string name="settings_summary_osd_show_messages">پیامهای روی صفحه را هنگام رویدادهایی مانند ذخیره یا بارگذاری وضعیت و گرفتن عکس نشان میدهد.</string>
    <string name="settings_summary_osd_show_speed">سرعت فعلی شبیهسازی را بهصورت درصد در گوشه بالای راست صفحه نشان میدهد.</string>
    <string name="settings_summary_osd_show_fps">نرخ فریم داخلی بازی را در گوشه بالای راست صفحه نشان میدهد.</string>
    <string name="settings_summary_osd_show_vps">تعداد فریمهای نمایشدادهشده در ثانیه را در گوشه بالای راست صفحه نشان میدهد.</string>
    <string name="settings_cdrom_read_speedup">تسریع خواندن CD-ROM</string>
    <string name="settings_summary_cdrom_read_speedup">خواندن CD-ROM را به اندازه مشخص تسریع میکند. فقط روی خواندنهای دو برابر اعمال میشود و هنگام پخش صدا نادیده گرفته میشود. ممکن است بارگذاری برخی بازیها را سریعتر کند ولی بازیهای دیگری را خراب کند.</string>
    <string name="settings_summary_console_fast_boot">از منوی بایوس و موسیقی آغازین میگذرد و مستقیم بازی را اجرا میکند. معمولاً فعال کردن آن ایمن است ولی برخی بازیها خراب میشوند.</string>
    <string name="settings_msaa">پوشش نمونهگیر چندگانه</string>
    <string name="settings_true_color">رندر رنگ واقعی (۲۴ بیتی، بدون dithering)</string>
    <string name="settings_summary_true_color">گرادیانهای زیباتری ایجاد میکند ولی رنگها کمی متفاوت میشوند. خاموش کردن آن dithering را فعال میکند. اکثر بازیها با این گزینه سازگارند.</string>
    <string name="settings_scaled_dithering">Dithering مقیاسشده (مقیاسکردن الگو بر اساس رزولوشن)</string>
    <string name="settings_summary_scaled_dithering">الگوی dithering را متناسب با مقیاس رزولوشن GPU شبیهسازی میکند. در رزولوشنهای بالا الگو کمتر دیده میشود. معمولاً فعال کردن آن ایمن است و فقط رندررهای سختافزاری پشتیبانیاش میکنند.</string>
    <string name="settings_disable_interlacing">غیرفعال کردن درهمتنیدگی (رندر و نمایش progressive)</string>
    <string name="settings_summary_disable_interlacing">رندر و نمایش فریمها را به حالت progressive میکند. اثر شانهای بازیهای 480i را با رندر 480p از بین میبرد. معمولاً فعال کردن آن ایمن است.</string>
    <string name="settings_texture_filtering">فیلتر بافت</string>
    <string name="settings_force_ntsc_timings">اجبار به زمانبندی NTSC (۶۰ هرتز در PAL)</string>
    <string name="settings_summary_force_ntsc_timings">از زمانبندی فریم NTSC حتی در حالت PAL استفاده میکند و بازیهای PAL را با ۶۰ هرتز اجرا میکند.</string>
    <string name="settings_widescreen_hack">حالت عریض</string>
    <string name="settings_summary_widescreen_hack">مختصات رئوس را در فضای صفحه به نسبت عریض تغییر میدهد و میدان دید 3D را اساساً از 4:3 به 16:9 میرساند. با همه بازیها سازگار نیست.</string>
    <string name="settings_force_4_3_for_24bit">اجبار 4:3 برای محتوای ۲۴ بیتی</string>
    <string name="settings_summary_force_4_3_for_24bit">هنگام نمایش محتوای ۲۴ بیتی (معمولاً ویدیوهای FMV) دوباره به نسبت 4:3 برمیگردد.</string>
    <string name="settings_chroma_smoothing_24bit">نرمسازی رنگ برای محتوای ۲۴ بیتی</string>
    <string name="settings_summary_chrome_smoothing_24bit">سختی انتقال رنگها را در محتوای ۲۴ بیتی (معمولاً FMV) نرم میکند. فقط رندررهای سختافزاری.</string>
    <string name="settings_pgxp_geometry_correction">تصحیح هندسه PGXP</string>
    <string name="settings_summary_pgxp_geometry_correction"><![CDATA[لرزش polygonها و کشیدگی بافتهای رایج در بازیهای PS1 را کاهش میدهد. فقط با رندررهای سختافزاری کار میکند. ممکن است با همه بازیها سازگار نباشد.]]></string>
    <string name="settings_pgxp_culling_correction">تصحیح حذف رئوس PGXP</string>
    <string name="settings_summary_pgxp_culling_correction">دقت حذف polygonها را بالا میبرد و تعداد سوراخها را در هندسه کم میکند. نیاز به فعال بودن تصحیح هندسه دارد.</string>
    <string name="settings_pgxp_texture_correction">تصحیح بافت PGXP</string>
    <string name="settings_summary_pgxp_texture_correction">برای مختصات بافت و رنگها از درونیابی با لحاظ چشمانداز استفاده میکند و بافتهای کشیدهشده را صاف میکند. نیاز به فعال بودن تصحیح هندسه دارد.</string>
    <string name="settings_pgxp_preserve_projection_precision">حفظ دقت تصویر PGXP</string>
    <string name="settings_summary_pgxp_preserve_projection_precision">دقت اضافی را برای PGXP فعال میکند. ممکن است بافت برخی بازیها را بهتر کند ولی بازیهای دیگری را خراب کند.</string>
    <string name="settings_pgxp_depth_buffer">بافر عمق PGXP</string>
    <string name="settings_summary_pgxp_depth_buffer">سعی میکند تداخل Z رئوس را با آزمون پیکسلها در برابر مقادیر عمق PGXP کاهش دهد. سازگاری پایینی دارد ولی در برخی بازیها خوب کار میکند.</string>
